# Claude Code 注册命令模板（把 <REPO_DIR> 替换为你的仓库绝对路径，任选其一，推荐第一条）

claude mcp add powerdesigner -- <REPO_DIR>/.venv/Scripts/python.exe -m pd_mcp serve

# 若 PYTHONPATH 未生效，改用安装为包的方式：
#   cd <REPO_DIR>
#   .venv\Scripts\python.exe -m pip install -e .
#   claude mcp add powerdesigner -- <REPO_DIR>/.venv/Scripts/powerdesigner-mcp.exe serve
